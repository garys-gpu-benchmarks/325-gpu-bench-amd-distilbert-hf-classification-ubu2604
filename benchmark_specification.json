  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --model-name distilbert-base-uncased --dataset-name glue-sst2-synthetic --sequence-len 32 --batch-size 2 --optimizer adamw --learning-rate 5e-05 --weight-decay 0.01 --num-iterations 2"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --model-name distilbert-base-uncased --dataset-name glue-sst2-synthetic --sequence-len 128 --batch-size 16 --optimizer adamw --learning-rate 5e-05 --weight-decay 0.01 --num-iterations 17300"
  },
