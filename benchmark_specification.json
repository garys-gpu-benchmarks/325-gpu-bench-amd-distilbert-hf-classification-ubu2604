  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run inline Hugging Face DistilBERT sequence-classification training on synthetic token batches with yaml sequence_len, batch_size, and num_iterations, then write samples/s, step time, and tokens/s, to measure DistilBERT training throughput. This is not pytest test_bench.py"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Train Hugging Face DistilBERT sequence classification inline on synthetic token batches for yaml sequence_len, batch_size, and num_iterations, then write samples/s, step time, and tokens/s. This is not pytest test_bench.py"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Trains DistilBertForSequenceClassification in-process on synthetic token batches (fp32 AdamW). sequence_len, batch_size, num_iterations, model_name, learning_rate, and weight_decay come from yaml. dataset_name and optimizer are ignored. loss is hardcoded 1.0. This is not pytest test_bench.py. output_format: csv"
  },
